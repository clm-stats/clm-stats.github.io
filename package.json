  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@preact/signals": "^2.7.1",
    "@tailwindcss/cli": "^4.1.18",
    "alpinejs": "^3.15.8",
    "bulma": "^1.0.4",
    "classnames": "^2.5.1",
    "daisyui": "^5.5.18",
    "execa": "^9.6.1",
    "htmx.org": "^2.0.8",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "path-browserify": "^1.0.1",
    "preact": "^10.28.3",
    "preact-render-to-string": "^6.6.5",
