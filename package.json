    "sass": "^1.97.3"
  },
  "staticFiles": {
    "staticPath": "static"
  },
  "targets": {
    "default": {
      "distDir": "./docs"
    }
  },
  "alias": {
    "react": "preact/compat",
    "react-dom/test-utils": "preact/test-utils",
